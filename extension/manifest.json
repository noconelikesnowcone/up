{
  "manifest_version": 3,
  "name": "Nextup Up",
  "version": "1.0.0",
  "description": "Reads the Nextup position column for the Omarchy bar.",
  "key": "",
  "permissions": ["nativeMessaging", "alarms"],
  "host_permissions": ["https://login.thenextup.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://login.thenextup.com/*"],
      "js": ["position.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
